generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RoomStatus {
  available
  occupied
  reserved
  cleaning
  maintenance
}

enum RoomAvailability {
  available
  unavailable
}

model User {
  id              Int       @id @default(autoincrement())
  name            String
  email           String    @unique @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at")
  password        String    @db.VarChar(255)
  phone           String?   @db.VarChar(50)
  address         String?   @db.Text
  rememberToken   String?   @map("remember_token") @db.VarChar(100)
  createdBy       Int?      @map("created_by")
  updatedBy       Int?      @map("updated_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  villasCreated   Villa[]            @relation("VillaCreator")
  villasUpdated   Villa[]            @relation("VillaUpdater")
  roomsCreated    Room[]             @relation("RoomCreator")
  roomsUpdated    Room[]             @relation("RoomUpdater")
  metricsCreated  DashboardMetric[] @relation("MetricCreator")
  metricsUpdated  DashboardMetric[] @relation("MetricUpdater")

  @@index([email])
  @@index([createdAt])
  @@map("users")
}

model Permission {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(255)
  guardName String   @default("web") @map("guard_name") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roleLinks   RoleHasPermissions[]
  userLinks   ModelHasPermissions[]

  @@map("permissions")
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(255)
  guardName String   @default("web") @map("guard_name") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userLinks  ModelHasRoles[]
  permLinks  RoleHasPermissions[]

  @@map("roles")
}

model ModelHasRoles {
  id        Int     @id @default(autoincrement())
  roleId    Int     @map("role_id")
  modelType String  @map("model_type") @db.VarChar(255)
  modelId   Int     @map("model_id")

  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([modelType, modelId, roleId])
  @@index([modelType, modelId])
  @@map("model_has_roles")
}

model ModelHasPermissions {
  id          Int     @id @default(autoincrement())
  permissionId Int    @map("permission_id")
  modelType   String  @map("model_type") @db.VarChar(255)
  modelId     Int     @map("model_id")

  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([modelType, modelId, permissionId])
  @@index([modelType, modelId])
  @@map("model_has_permissions")
}

model RoleHasPermissions {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_has_permissions")
}

model DashboardMetric {
  id                  Int       @id @default(autoincrement())
  metricDate          DateTime  @unique @map("metric_date") @db.Date
  totalOccupancy      Int       @default(0) @map("total_occupancy")
  totalRooms          Int       @default(0) @map("total_rooms")
  dailyRevenue        Decimal   @default(0) @map("daily_revenue") @db.Decimal(15, 2)
  dailyExpenses       Decimal   @default(0) @map("daily_expenses") @db.Decimal(15, 2)
  dailyProfit         Decimal   @default(0) @map("daily_profit") @db.Decimal(15, 2)
  checkinCount        Int       @default(0) @map("checkin_count")
  checkoutCount       Int       @default(0) @map("checkout_count")
  maintenancePending  Int       @default(0) @map("maintenance_pending")
  housekeepingPending Int       @default(0) @map("housekeeping_pending")
  createdBy           Int?      @map("created_by")
  updatedBy           Int?      @map("updated_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  userCreatedBy User? @relation("MetricCreator", fields: [createdBy], references: [id])
  userUpdatedBy User? @relation("MetricUpdater", fields: [updatedBy], references: [id])

  @@index([metricDate])
  @@map("dashboard_metrics")
}

model VillaType {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(255)
  description String?  @db.Text
  maxGuests   Int      @default(1) @map("max_guests")
  bedrooms    Int      @default(1)
  bathrooms   Int      @default(1)
  basePrice   Decimal  @map("base_price") @db.Decimal(15, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   Int?     @map("created_by")
  updatedBy   Int?     @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  villas Villa[]

  @@index([isActive])
  @@map("villa_types")
}

model Villa {
  id            Int       @id @default(autoincrement())
  name          String    @unique @db.VarChar(255)
  description   String?   @db.Text
  villaTypeId   Int       @map("villa_type_id")
  location      String?   @db.VarChar(255)
  address       String?   @db.Text
  pricePerNight Decimal   @map("price_per_night") @db.Decimal(15, 2)
  maxGuests     Int       @default(1) @map("max_guests")
  bedrooms      Int       @default(1)
  bathrooms     Int       @default(1)
  totalRooms    Int       @default(0) @map("total_rooms")
  amenities     String?   @db.Text
  isActive      Boolean   @default(true) @map("is_active")
  isAvailable   Boolean   @default(true) @map("is_available")
  createdBy     Int?      @map("created_by")
  updatedBy     Int?      @map("updated_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  villaType      VillaType           @relation(fields: [villaTypeId], references: [id], onDelete: Restrict)
  images         VillaImage[]
  facilityLinks  VillaHasFacility[]
  availabilities  VillaAvailability[]
  rooms          Room[]
  creator        User?               @relation("VillaCreator", fields: [createdBy], references: [id])
  updater        User?               @relation("VillaUpdater", fields: [updatedBy], references: [id])

  @@index([isActive])
  @@index([isAvailable])
  @@fulltext([name, description])
  @@map("villas")
}

model VillaImage {
  id        Int      @id @default(autoincrement())
  villaId   Int      @map("villa_id")
  imagePath String   @map("image_path") @db.VarChar(500)
  caption   String?  @db.VarChar(255)
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  villa Villa @relation(fields: [villaId], references: [id], onDelete: Cascade)

  @@index([villaId])
  @@index([isPrimary])
  @@map("villa_images")
}

model Facility {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(255)
  description String?  @db.Text
  icon        String?  @db.VarChar(100)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  villaLinks VillaHasFacility[]

  @@map("villa_facilities")
}

model VillaHasFacility {
  id          Int      @id @default(autoincrement())
  villaId     Int      @map("villa_id")
  facilityId  Int      @map("villa_facility_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  villa     Villa    @relation(fields: [villaId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([villaId, facilityId])
  @@map("villa_has_facilities")
}

model VillaAvailability {
  id            Int      @id @default(autoincrement())
  villaId       Int      @map("villa_id")
  availableFrom DateTime @map("available_from") @db.Date
  availableTo   DateTime? @map("available_to") @db.Date
  isAvailable   Boolean  @default(true) @map("is_available")
  createdBy     Int?     @map("created_by")
  updatedBy     Int?     @map("updated_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  villa Villa @relation(fields: [villaId], references: [id], onDelete: Cascade)

  @@index([villaId])
  @@index([availableFrom, availableTo])
  @@map("villa_availability")
}

model RoomType {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(255)
  description String?  @db.Text
  basePrice   Decimal  @map("base_price") @db.Decimal(15, 2)
  maxGuests   Int      @default(1) @map("max_guests")
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   Int?     @map("created_by")
  updatedBy   Int?     @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  rooms Room[]

  @@index([isActive])
  @@map("room_types")
}

model Room {
  id            Int              @id @default(autoincrement())
  roomNumber    String           @unique @map("room_number") @db.VarChar(50)
  villaId       Int              @map("villa_id")
  roomTypeId    Int              @map("room_type_id")
  status        RoomStatus       @default(available)
  availability  RoomAvailability @default(available)
  maxGuests     Int              @default(1) @map("max_guests")
  pricePerNight Decimal          @map("price_per_night") @db.Decimal(15, 2)
  description   String?          @db.Text
  floorNumber   Int?             @map("floor_number")
  isActive      Boolean          @default(true) @map("is_active")
  createdBy     Int?             @map("created_by")
  updatedBy     Int?             @map("updated_by")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  deletedAt     DateTime?        @map("deleted_at")

  villa          Villa             @relation(fields: [villaId], references: [id], onDelete: Cascade)
  roomType       RoomType          @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  images         RoomImage[]
  amenityLinks  RoomHasAmenity[]
  pricing        RoomPricing[]
  creator        User?             @relation("RoomCreator", fields: [createdBy], references: [id])
  updater        User?             @relation("RoomUpdater", fields: [updatedBy], references: [id])

  @@index([villaId])
  @@index([status])
  @@index([availability])
  @@index([isActive])
  @@map("rooms")
}

model RoomImage {
  id        Int      @id @default(autoincrement())
  roomId    Int      @map("room_id")
  imagePath String   @map("image_path") @db.VarChar(500)
  caption   String?  @db.VarChar(255)
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([isPrimary])
  @@map("room_images")
}

model Amenity {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(255)
  description String?  @db.Text
  icon        String?  @db.VarChar(100)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roomLinks RoomHasAmenity[]

  @@map("room_amenities")
}

model RoomHasAmenity {
  id         Int      @id @default(autoincrement())
  roomId     Int      @map("room_id")
  amenityId  Int      @map("room_amenity_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([roomId, amenityId])
  @@map("room_has_amenities")
}

model RoomPricing {
  id        Int       @id @default(autoincrement())
  roomId    Int       @map("room_id")
  validFrom DateTime  @map("valid_from") @db.Date
  validTo   DateTime? @map("valid_to") @db.Date
  price     Decimal   @db.Decimal(15, 2)
  season    String?   @db.VarChar(100)
  minNights Int       @default(1) @map("min_nights")
  isActive  Boolean   @default(true) @map("is_active")
  createdBy Int?      @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([validFrom, validTo])
  @@map("room_pricing")
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  logName     String?  @map("log_name") @db.VarChar(255)
  description String?  @db.Text
  subjectType String?  @map("subject_type") @db.VarChar(255)
  subjectId   Int?     @map("subject_id")
  causerType  String?  @map("causer_type") @db.VarChar(255)
  causerId    Int?     @map("causer_id")
  properties  String?  @db.Text
  batchUuid   String?  @map("batch_uuid") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([subjectType, subjectId])
  @@index([causerType, causerId])
  @@map("activity_log")
}
